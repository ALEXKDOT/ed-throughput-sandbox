{
  "name": "ed-throughput-sandbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A browser-based discrete-event simulation for comparing emergency-department flow, capacity, and boarding scenarios.",
  "author": "Alexander Krawec",
  "license": "MIT",
  "homepage": "https://ALEXKDOT.github.io/ed-throughput-sandbox/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALEXKDOT/ed-throughput-sandbox.git"
  },
  "bugs": {
    "url": "https://github.com/ALEXKDOT/ed-throughput-sandbox/issues"
  },
  "scripts": {
    "assets:social": "node scripts/render-social-preview.mjs",
    "assets:social:check": "node scripts/render-social-preview.mjs --check",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "tsc -b && SITES_BUILD=true vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.61.0",
    "@eslint/js": "10.0.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "^4.131.2"
  }
}
